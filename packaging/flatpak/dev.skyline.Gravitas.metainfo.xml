<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>dev.skyline.Gravitas</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Gravitas</name>
  <summary>Minimal, no-nonsense alternative to Stremio</summary>
  <developer id="dev.skyline">
    <name>skyline69</name>
  </developer>
  <url type="homepage">https://github.com/skyline69/gravitas</url>
  <url type="bugtracker">https://github.com/skyline69/gravitas/issues</url>
  <url type="vcs-browser">https://github.com/skyline69/gravitas</url>
  <description>
    <p>
      Gravitas is a minimal, no-nonsense media center that speaks the Stremio
      addon protocol. Install any Stremio addon by pasting its manifest URL,
      browse its catalogs, and play direct HTTP/HLS streams through an
      embedded libmpv player.
    </p>
    <ul>
      <li>Stremio addon support — Cinemeta metadata out of the box, one-click stremio:// installs from addon sites</li>
      <li>Embedded mpv playback with subtitle styling, track selection and resume</li>
      <li>Cross-addon search, watchlist, continue watching and watched-progress everywhere</li>
      <li>Trakt sync for progress, history and personalized rows</li>
      <li>Fast: aggressive caching, HTTP/2 fan-out, instant warm starts</li>
    </ul>
  </description>
  <launchable type="desktop-id">dev.skyline.Gravitas.desktop</launchable>
  <provides>
    <binary>gravitas</binary>
  </provides>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
    <category>Player</category>
  </categories>
  <keywords>
    <keyword>stremio</keyword>
    <keyword>streaming</keyword>
    <keyword>movies</keyword>
    <keyword>series</keyword>
    <keyword>mpv</keyword>
    <keyword>media center</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#8B5CF6</color>
